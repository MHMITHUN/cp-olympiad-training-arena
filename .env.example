# MongoDB connection string. Leave unset to run in Demo mode
# (in-memory store, seeded lazily, resets on server restart).
# Example: mongodb://localhost:27017
# MONGODB_URI=

# Database name used when MONGODB_URI is set.
MONGODB_DB_NAME=cp_arena

# Secret used to sign session cookies (HMAC-SHA256).
# REQUIRED in production. If unset, a demo fallback secret is used.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Judge0 API for real code verdicts (optional). When BOTH are unset the
# judge adapter runs in demo mode: submissions are recorded with verdict
# "recorded" and clearly labeled "Judge unavailable - submission recorded
# for teacher review. Connect Judge0 for real verdicts." Demo mode NEVER
# fabricates accepted/wrong-answer verdicts.
# JUDGE0_API_URL=
# JUDGE0_API_KEY=
